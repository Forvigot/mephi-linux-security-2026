    1  su - user1
    2  exit
    3  cat /etc/os-release | head -n 3
    4  groupadd students
    5  useradd -u 1234 -m -s /bin/bash -G students user1
    6  head -c 18 /dev/urandom | base64 > ~/pw.txt; chmod 600 ~/pw.txt
    7  passwd --stdin user1 < ~/pw.txt
    8  chage -M 90 user1
    9  chmod 700 /home/user1
   10  id user1
   11  chage -l user1
   12  find / -type f -perm -4000 -ls 2>/dev/null | tee ~/suid_files.out
   13  ps -eo pid,ppid,ruid,euid,ruser,euser,tty,cmd | awk 'NR==1 || ($3>=1000 && $3!=65534 && $4==0)' | tee ~/priv_procs.out
   14  su - user1 -c 'cat /etc/shadow'
   15  cp /usr/bin/cat /home/user1/mycat
   16  chown root:students /home/user1/mycat
   17  chmod 4750 /home/user1/mycat
   18  ls -l /home/user1/mycat
   19  su - user1 -c '~/mycat /etc/shadow | cut -d: -f1 | tail -n 3'
   20  su - user1 -c 'touch ~/test.txt; chown root ~/test.txt'
   21  cp /usr/bin/chown /home/user1/mychown
   22  chown root:students /home/user1/mychown
   23  chmod 750 /home/user1/mychown
   24  setcap cap_chown=ep /home/user1/mychown
   25  getcap /home/user1/mychown
   26  su - user1 -c '~/mychown root ~/test.txt; ls -l ~/test.txt'
   27  echo 'user1 ALL=(root) /usr/bin/date -s *, /usr/bin/timedatectl set-time *' | EDITOR='tee -a' visudo
   28  visudo -c
   29  sudo -l -U user1
   30  timedatectl set-ntp false
   31  su - user1 -c 'sudo -S date -s "$(date "+%F %T")"' < ~/pw.txt
   32  su - user1 -c 'sudo -S timedatectl set-time "$(date "+%F %T")"' < ~/pw.txt; echo code=$?
   33  su - user1 -c 'sudo -S cat /etc/shadow' < ~/pw.txt
   34  timedatectl set-ntp true
   35  history -a
   36  exit
   37  cat ~/pw.txt | passwd --stdin user1
   38  chage -M 90 user1
   39  passwd -S user1
   40  timedatectl set-ntp false
   41  su - user1 -c 'sudo -S date -s "$(date "+%F %T")"' < ~/pw.txt; echo code=$?
   42  su - user1 -c 'sudo -S timedatectl set-time "$(date "+%F %T")"' < ~/pw.txt; echo code=$?
   43  su - user1 -c 'sudo -S cat /etc/shadow' < ~/pw.txt; echo code=$?
   44  timedatectl set-ntp true
   45  history -a
   46  reboot
   47  rm -f ~/pw.txt
   48  stat /home/user1 > ~/stat.out
   49  stat /home/user1/mycat >> ~/stat.out
   50  stat /home/user1/mychown >> ~/stat.out
   51  getcap /home/user1/mychown > ~/getcap.out
   52  clear
   53  head -n 2 /etc/os-release
   54  id user1
   55  ls -l /home/user1
   56  getcap /home/user1/mychown
   57  tail -n 1 /etc/sudoers
   58  echo M265323
   59  history > ~/history.out
