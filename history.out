    1  cat /etc/os-release | head -n 3
    2  groupadd students
    3  useradd -u 1234 -m -s /bin/bash -G students user1
    4  head -c 18 /dev/urandom | base64 > ~/pw.txt; chmod 600 ~/pw.txt
    5  passwd --stdin user1 < ~/pw.txt
    6  chage -M 90 user1
    7  chmod 700 /home/user1
    8  id user1
    9  chage -l user1
   10  find / -type f -perm -4000 -ls 2>/dev/null | tee ~/suid_files.out
   11  su - user1 -c 'sleep 30 | passwd' &
   12  sleep 3
   13  ps -eo pid,ppid,ruid,euid,ruser,euser,cmd | awk 'NR==1 || ($3>=1000 && $3!=65534 && $4==0)' | tee ~/priv_procs.out
   14  su - user1 -c 'cat /etc/shadow'
   15  cp /usr/bin/cat /home/user1/mycat
   16  chown root:students /home/user1/mycat
   17  chmod 4750 /home/user1/mycat
   18  ls -l /home/user1/mycat
   19  su - user1 -c '~/mycat /etc/shadow | cut -c1-12'
   20  su - user1 -c 'touch ~/test.txt; chown root ~/test.txt'
   21  cp /usr/bin/chown /home/user1/mychown
   22  chown root:students /home/user1/mychown
   23  chmod 750 /home/user1/mychown
   24  setcap cap_chown=ep /home/user1/mychown
   25  getcap /home/user1/mychown
   26  su - user1 -c '~/mychown root ~/test.txt; ls -l ~/test.txt'
   27  cp -p /etc/sudoers ~/sudoers.bak
   28  echo 'user1 ALL=(root) /usr/bin/date -s *, /usr/bin/timedatectl set-time *' | EDITOR='tee -a' visudo
   29  visudo -c
   30  sudo -l -U user1
   31  su - user1 -c 'sudo -S date -s "$(date "+%F %T")"' < ~/pw.txt
   32  su - user1 -c 'sudo -S cat /etc/shadow' < ~/pw.txt
   33  stat /home/user1 > ~/stat.out
   34  stat /home/user1/mycat >> ~/stat.out
   35  stat /home/user1/mychown >> ~/stat.out
   36  getcap /home/user1/mychown > ~/getcap.out
   37  echo M265323
   38  history > ~/history.out
